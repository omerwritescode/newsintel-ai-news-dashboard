    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const title = $input.item.json.title || \"No title\";\nconst description = $input.item.json.description || \"No description\";\n\nconst prompt = `You are an AI news analyst. Analyze this article and return ONLY valid JSON with no extra text, no markdown, no code blocks.\n\nArticle Title: ${title}\nArticle Description: ${description}\n\nReturn exactly this structure:\n{\n  \"summary\": \"2-3 sentence summary of the article\",\n  \"sentiment\": \"positive OR negative OR neutral\",\n  \"category\": \"news category like Technology, Politics, Business etc\",\n  \"insights\": {\n    \"key_points\": [\"point 1\", \"point 2\", \"point 3\"],\n    \"companies_mentioned\": [\"company name\"],\n    \"importance_score\": 7\n  }\n}`;\n\nreturn {\n  json: {\n    contents: [\n      {\n        parts: [\n          {\n            text: prompt\n          }\n        ]\n      }\n    ]\n  }\n};"
      },
